{
  "types": [
    {
      "key": "fork",
      "name": "分叉自",
      "desc": "从另一个项目分出来独立发展"
    },
    {
      "key": "built_on",
      "name": "基于",
      "desc": "建立在另一个项目之上，离开它不能用"
    },
    {
      "key": "plugin",
      "name": "插件 / 扩展",
      "desc": "给另一个项目加功能"
    },
    {
      "key": "official",
      "name": "官方模板 / 技能",
      "desc": "同一团队出的模板或 AI 技能"
    },
    {
      "key": "uses",
      "name": "用它渲染",
      "desc": "默认用另一个项目做渲染或底层处理"
    },
    {
      "key": "data",
      "name": "数据来源",
      "desc": "用另一个项目提供的数据"
    },
    {
      "key": "alt",
      "name": "同类可替换",
      "desc": "做的事情相近，可以互相替换"
    },
    {
      "key": "pair",
      "name": "常搭配",
      "desc": "经常一起使用"
    },
    {
      "key": "author",
      "name": "同一作者",
      "desc": "同一个人或团队的作品"
    }
  ],
